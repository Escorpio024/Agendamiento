generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/@prisma/bot-client"
  binaryTargets = ["native"]
}

datasource db {
  provider = "sqlite"
  url      = env("BOT_DATABASE_URL")
}

model Conversation {
  id            String    @id
  name          String?
  status        String    @default("bot")
  unreadCount   Int       @default(0)
  lastMessageAt DateTime  @default(now())
  messages      Message[]
}

model Message {
  id             String       @id
  conversationId String
  fromMe         Boolean      @default(false)
  body           String
  type           String       @default("chat")
  mediaUrl       String?
  timestamp      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

model AppointmentLog {
  id              String   @id @default(cuid())
  patientName     String
  patientDocument String
  doctorId        String?
  doctorName      String?
  appointmentDate String
  appointmentTime String
  serviceType     String?
  whatsappId      String
  patientPhone    String?
  createdAt       DateTime @default(now())
}

model CvdProgramadoHistorial {
  id         String   @id @default(cuid())
  cedula     String
  examCodigo String
  tipoExamen String
  fecha      String?
  doctor     String?
  accion     String
  motivo     String?
  creadoEn   DateTime @default(now())
}

model CvdCitaProgramada {
  id           String   @id @default(cuid())
  cedula       String
  paciente     String
  doctorId     String?
  doctorNombre String?
  examCodigo   String
  tipoExamen   String
  fecha        String?
  hora         String?
  notas        String?
  creadoEn     DateTime @default(now())
}

model ControlReminder {
  id                String   @id @default(cuid())
  cedula            String
  paciente          String
  medicoOriginal    String?
  fechaCitaOriginal String
  articuloCita      String?
  fechaControl      String
  fechaRecordatorio String
  estado            String   @default("PENDING")
  epsInfo           String?
  entidadCod        Int?
  citaMedico        String?
  citaFch           String?
  citaHh            String?
  citaMm            String?
  citaZona          String?
  citaSeqk          String?
  citaHora          String?
  createdAt         DateTime @default(now())
}

model Campaign {
  id          String        @id @default(cuid())
  name        String
  messageBody String
  status      String        @default("DRAFT") // DRAFT, SENDING, COMPLETED
  sentCount   Int           @default(0)
  totalCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  logs        CampaignLog[]
}

model CampaignLog {
  id           String   @id @default(cuid())
  campaignId   String
  patientPhone String
  status       String   @default("SENT") // SENT, FAILED
  error        String?
  sentAt       DateTime @default(now())
  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}
